import argparse
import os
import re
import secrets
import string
import sys
from pathlib import Path

__version__ = "1.1.0"

PROG = "generate-passwd"

DEFAULT_LENGTH = 32
DEFAULT_LANGUAGE = "fi"
DEFAULT_WORD_SEPARATOR = "-"
DEFAULT_WORD_COUNT = 8
DEFAULT_QUANTITY = 5

# Where wordlist-<language>.txt is looked up, in order. The first two entries
# let the script run straight out of a checkout or from any --prefix install
# (/usr/local/bin/generate-passwd -> /usr/local/share/generate-passwd/).
_SCRIPT_DIR = Path(__file__).resolve().parent
WORDLIST_DIRS = (
    _SCRIPT_DIR,
    _SCRIPT_DIR.parent / "share" / PROG,
    Path("/usr/local/share") / PROG,
    Path("/usr/share") / PROG,
)

# Last resort for English only, so the script stays useful uninstalled.
SYSTEM_DICTS = {"en": Path("/usr/share/dict/words")}

LANGUAGE_RE = re.compile(r"\A[a-z][a-z0-9_-]{1,15}\Z")

rng = secrets.SystemRandom()


class PasswdError(Exception):
    """Anything that should exit with a message instead of a traceback."""


def read_wordlist(path):
    """Return the words in `path`, or None if it is missing or unusable."""
    try:
        raw = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    words = sorted({w.lower() for w in (line.strip() for line in raw.splitlines()) if w.isalpha()})
    return words if len(words) >= 100 else None


def available_languages():
    """Language codes with a wordlist somewhere in WORDLIST_DIRS."""
    found = set()
    for directory in WORDLIST_DIRS:
        try:
            entries = directory.glob("wordlist-*.txt")
            found.update(p.name[len("wordlist-"):-len(".txt")] for p in entries)
        except OSError:
            continue
    found.update(lang for lang, path in SYSTEM_DICTS.items() if path.exists())
    return sorted(found)


def load_words(language):
    """Return the wordlist for `language`, honouring $GENERATE_PASSWD_WORDLIST."""
    override = os.environ.get("GENERATE_PASSWD_WORDLIST")
    if override:
        words = read_wordlist(Path(override))
        if words is None:
            raise PasswdError(f"no usable wordlist at {override}")
        return words

    if not LANGUAGE_RE.match(language):
        raise PasswdError(f"invalid --language {language!r}")

    candidates = [d / f"wordlist-{language}.txt" for d in WORDLIST_DIRS]
    if language in SYSTEM_DICTS:
        candidates.append(SYSTEM_DICTS[language])
    for path in candidates:
        words = read_wordlist(path)
        if words is not None:
            return words

    known = available_languages()
    raise PasswdError(
        f"no wordlist for language {language!r}; looked for "
        + ", ".join(str(p) for p in candidates)
        + ("\nAvailable: " + ", ".join(known) if known else "")
        + "\nOr set GENERATE_PASSWD_WORDLIST=/path/to/wordlist.txt, or use --string."
    )


def random_string(length, mixed_case):
    """A random alphanumeric string of the given length."""
    alphabet = string.ascii_lowercase + string.digits
    if mixed_case:
        alphabet += string.ascii_uppercase
    return "".join(rng.choice(alphabet) for _ in range(length))


def random_words(words, count, separator, mixed_case):
    """A passphrase of `count` words joined by `separator`."""
    picked = [rng.choice(words) for _ in range(count)]
    if mixed_case:
        # Capitalise each word independently, so the pattern is not predictable.
        picked = [w.capitalize() if rng.getrandbits(1) else w for w in picked]
    return separator.join(picked)


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog=PROG,
        description=__doc__.splitlines()[0],
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "-l", "--length", type=int, default=DEFAULT_LENGTH,
        help="password length in characters (string mode only)",
    )
    parser.add_argument(
        "-m", "--mixed-case", action=argparse.BooleanOptionalAction, default=True,
        help="mix lowercase and uppercase",
    )
    parser.add_argument(
        "-s", "--string", action="store_true",
        help="generate a random character string instead of words",
    )
    parser.add_argument(
        "-w", "--words", action="store_true",
        help="generate words (the default; ignored when --string is given)",
    )
    parser.add_argument(
        "--language", default=DEFAULT_LANGUAGE, metavar="CODE",
        help="which wordlist to draw from, e.g. fi or en (word mode only)",
    )
    parser.add_argument(
        "--word-separator", default=DEFAULT_WORD_SEPARATOR, metavar="CHAR",
        help="what to put between the words",
    )
    parser.add_argument(
        "-c", "--word-count", type=int, default=DEFAULT_WORD_COUNT, metavar="N",
        help="how many words the password contains (word mode only)",
    )
    parser.add_argument(
        "-q", "--quantity", type=int, default=DEFAULT_QUANTITY, metavar="N",
        help="how many passwords to generate",
    )
    parser.add_argument("-V", "--version", action="version", version=f"{PROG} {__version__}")

    args = parser.parse_args(argv)
    # --string wins over --words, and word mode is the default otherwise.
    args.words = not args.string
    return args


def generate(args):
    if args.quantity < 1:
        raise PasswdError("--quantity must be at least 1")

    if args.string:
        if args.length < 1:
            raise PasswdError("--length must be at least 1")
        return [random_string(args.length, args.mixed_case) for _ in range(args.quantity)]

    if args.word_count < 1:
        raise PasswdError("--word-count must be at least 1")
    words = load_words(args.language)
    return [
        random_words(words, args.word_count, args.word_separator, args.mixed_case)
        for _ in range(args.quantity)
    ]


def main(argv=None):
    args = parse_args(argv)
    try:
        for password in generate(args):
            print(password)
    except PasswdError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        # e.g. `generate-passwd -q 1000 | head`
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
